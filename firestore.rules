rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function userExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function isCreator() {
      return isSignedIn() && (
        request.auth.token.email in ['iluha1032020@gmail.com', 'iluha032020@gmail.com'] ||
        (userExists(request.auth.uid) && 
         (getUserData(request.auth.uid).get('role', 'user') == 'creator' || getUserData(request.auth.uid).get('id', -1) == 1))
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isCreator() ||
        (userExists(request.auth.uid) && 
         getUserData(request.auth.uid).get('role', 'user') == 'admin')
      );
    }

    function isBanned() {
      return isSignedIn() && !isCreator() && userExists(request.auth.uid) && 
        getUserData(request.auth.uid).get('isBanned', false) == true;
    }

    function isMuted() {
      return isSignedIn() && !isCreator() && userExists(request.auth.uid) && 
        getUserData(request.auth.uid).get('isMuted', false) == true;
    }

    // --- User Rules ---
    match /users/{userId} {
      allow get, list: if true;
      allow create: if isOwner(userId) && 
        request.resource.data.keys().hasAll(['uid', 'email', 'id', 'createdAt', 'handle']);

      // Creator has full unrestricted update permissions. Admins have moderation permissions. Owners can update their profile.
      allow update: if isCreator() ||
         (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio', 'theme', 'language', 'handle', 'twoFactorEnabled', 'twoFactorSecret', 'lastSeen', 'fontSize', 'bubbleStyle', 'soundEnabled'])) ||
         (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isBanned', 'banReason', 'banExpires', 'isMuted', 'muteReason', 'muteExpires', 'isVerified', 'verificationCode', 'role', 'id']));
      allow delete: if isCreator() || isOwner(userId);
    }

    // --- Moderation Logs ---
    match /moderation_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isCreator();
    }

    // --- Report Rules ---
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.keys().hasAll(['reporterId', 'targetId', 'reason', 'status', 'createdAt']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Chat Rules ---
    match /chats/{chatId} {
      allow get: if isSignedIn() && (chatId == 'global_chat' || request.auth.uid in resource.data.memberIds || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in resource.data.memberIds || isAdmin());
      
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isCreator() || isAdmin() || (chatId == 'global_chat') || (request.auth.uid in resource.data.memberIds)
      );
      allow delete: if isCreator() || isAdmin() || (isSignedIn() && resource.data.get('creatorId', '') == request.auth.uid);
    }

    // --- Message Rules ---
    match /chats/{chatId}/messages/{messageId} {
      allow read: if isSignedIn() && (chatId == 'global_chat' || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds || isAdmin());
      
      allow create: if isSignedIn() && (
        isCreator() || 
        (!isBanned() && !isMuted() && (chatId == 'global_chat' || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds || isAdmin()))
      );

      allow update: if isSignedIn() && (
        isCreator() ||
        (!isBanned() && (
          // Message edit by sender
          (resource.data.senderId == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])) ||
          // Reaction toggle by chat member or in global_chat
          ((chatId == 'global_chat' || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds || isAdmin()) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])) ||
          // Pin/unpin by chat member or admin
          ((chatId == 'global_chat' || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds || isAdmin()) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned', 'pinnedAt']))
        ))
      );

      allow delete: if isSignedIn() && (resource.data.senderId == request.auth.uid || isAdmin());
    }

    // --- System Config ---
    match /system/{configId} {
      allow read: if isSignedIn();
      allow update: if isCreator() || (isSignedIn() && configId == 'config' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availableIds', 'userSequence', 'globalChatLock']));
      allow create: if isCreator() || (isSignedIn() && configId == 'config');
      allow delete: if isCreator();
    }
  }
}
